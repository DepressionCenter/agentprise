{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "Pinned tools server",
  "namespace": "pinned",
  "description_for_human": "Pinned tools server",
  "description_for_model": "Searches records on a tool server.",
  "functions": [
    {
      "name": "search"
    },
    {
      "name": "fetch"
    }
  ],
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "auth": {
        "type": "OAuthPluginVault",
        "reference_id": "replace-with-your-auth-registration-id"
      },
      "spec": {
        "url": "https://tools.example.org/mcp"
      },
      "run_for_functions": [
        "search",
        "fetch"
      ]
    }
  ],
  "privacy_policy_url": "https://example.org/privacy",
  "legal_info_url": "https://example.org/terms"
}